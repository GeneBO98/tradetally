+// Pull a field from an MT4/MT5 record using a list of candidate header names.
+// Matches case-insensitively because the Proxy wrapping at parse time isn't
+// guaranteed for non-known brokers and exports vary between UPPER and Title
+// case.
+function pickMetaTraderField(record, candidates) {
+  if (!record) return undefined;
+  for (const key of candidates) {
+    if (Object.prototype.hasOwnProperty.call(record, key) && record[key] != null && record[key] !== '') {
+      return record[key];
+    }
+  }
+  // Case-insensitive fallback
+  const lowered = candidates.map(c => c.toLowerCase());
+  for (const recKey of Object.keys(record)) {
+    if (lowered.includes(recKey.toLowerCase()) && record[recKey] != null && record[recKey] !== '') {
+      return record[recKey];
+    }
+  }
+  return undefined;
+}
+
+function normalizeMetaTraderEntry(value) {
+  if (!value) return '';
+  const v = value.toString().trim().toLowerCase();
+  // "in" / "entrada" → open execution; "out" / "salida" → close execution.
+  if (v === 'in' || v === 'entrada' || v === 'entry' || v === 'open') return 'in';
+  if (v === 'out' || v === 'salida' || v === 'exit' || v === 'close') return 'out';
+  // MT5 sometimes marks reversals as "in/out" or "out/in"
+  if (v.startsWith('in')) return 'in';
+  if (v.startsWith('out')) return 'out';
+  return '';
+}
+
+function parseMetaTraderDeals(records, diagnostics) {
+  if (diagnostics) {
+    diagnostics.totalRows = records.length;
+  }
+
+  // Bucket rows by ticket so opening and closing executions can be paired.
+  // MT5 deals may have separate position IDs and order IDs; when both exist we
+  // prefer position id for grouping because the in/out pair shares it.
+  const tickets = new Map();
+  let rowIndex = 0;
+  const skipReasons = diagnostics ? diagnostics.skippedReasons : [];
+
+  for (const record of records) {
+    rowIndex++;
+    const positionId = pickMetaTraderField(record, ['POSITION_ID', 'Position_ID', 'position_id', 'Position ID']);
+    const ticket = pickMetaTraderField(record, ['TICKET', 'Ticket', 'ticket', 'Order', 'ORDER', 'Deal']);
+    const groupKey = (positionId || ticket || '').toString().trim();
+
+    if (!groupKey) {
+      if (diagnostics) {
+        diagnostics.invalidRows++;
+        skipReasons.push({ row: rowIndex, reason: 'MetaTrader row is missing a ticket / position id, cannot pair with a counterparty execution.' });
+      }
+      continue;
+    }
+
+    const entry = normalizeMetaTraderEntry(pickMetaTraderField(record, ['ENTRY', 'Entry', 'entry']));
+    if (!tickets.has(groupKey)) {
+      tickets.set(groupKey, { open: null, close: null, fallback: [], rowIndex });
+    }
+    const bucket = tickets.get(groupKey);
+    if (entry === 'in' && !bucket.open) {
+      bucket.open = { record, rowIndex };
+    } else if (entry === 'out' && !bucket.close) {
+      bucket.close = { record, rowIndex };
+    } else {
+      bucket.fallback.push({ record, rowIndex });
+    }
+  }
+
+  const completedTrades = [];
+
+  for (const [ticketKey, bucket] of tickets.entries()) {
+    let openEntry = bucket.open;
+    let closeEntry = bucket.close;
+
+    // When ENTRY column is absent or non-standard, fall back to chronological
+    // ordering of the rows that arrived for this ticket.
+    if (!openEntry && bucket.fallback.length) {
+      bucket.fallback.sort((a, b) => {
+        const da = new Date(pickMetaTraderField(a.record, ['DATE', 'Date', 'date', 'Time', 'TIME', 'time'])).getTime() || 0;
+        const db = new Date(pickMetaTraderField(b.record, ['DATE', 'Date', 'date', 'Time', 'TIME', 'time'])).getTime() || 0;
+        return da - db;
+      });
+      openEntry = bucket.fallback[0];
+      if (bucket.fallback.length > 1 && !closeEntry) {
+        closeEntry = bucket.fallback[bucket.fallback.length - 1];
+      }
+    }
+
+    if (!openEntry) {
+      if (diagnostics) {
+        diagnostics.invalidRows++;
+        skipReasons.push({ row: bucket.rowIndex, reason: `Ticket ${ticketKey}: no opening execution found.` });
+      }
+      continue;
+    }
+
+    const openRow = openEntry.record;
+    const closeRow = closeEntry ? closeEntry.record : null;
+
+    const symbol = cleanString(pickMetaTraderField(openRow, ['SYMBOL', 'Symbol', 'symbol', 'Instrument', 'INSTRUMENT'])) || '';
+    const rawType = (pickMetaTraderField(openRow, ['TYPE', 'Type', 'type']) || '').toString().toLowerCase().trim();
+    let side = 'long';
+    if (rawType.includes('sell') || rawType === '1' || rawType.includes('short') || rawType.includes('venta') || rawType.includes('vender')) {
+      side = 'short';
+    } else {
+      side = 'long';
+    }
+
+    const quantity = Math.abs(parseNumeric(
+      pickMetaTraderField(openRow, ['VOLUME', 'Volume', 'volume', 'LOTS', 'Lots', 'lots', 'Size', 'SIZE', 'size'])
+    ));
+    const openPrice = parseNumeric(pickMetaTraderField(openRow, ['PRICE', 'Price', 'price', 'Open Price', 'OpenPrice']));
+    const openTimeRaw = pickMetaTraderField(openRow, ['DATE', 'Date', 'date', 'Time', 'TIME', 'time', 'Open Time']);
+    const stopLoss = parseNumeric(pickMetaTraderField(openRow, ['STOPLOSS', 'Stoploss', 'stoploss', 'Stop Loss', 'SL', 'S/L', 's/l'])) || null;
+    const takeProfit = parseNumeric(pickMetaTraderField(openRow, ['TAKEPROFIT', 'Takeprofit', 'takeprofit', 'Take Profit', 'TP', 'T/P', 't/p'])) || null;
+    const comment = cleanString(pickMetaTraderField(openRow, ['COMMENT', 'Comment', 'comment'])) || '';
+    const magic = cleanString(pickMetaTraderField(openRow, ['MAGIC', 'Magic', 'magic'])) || '';
+
+    let commission = parseNumeric(pickMetaTraderField(openRow, ['COMMISSION', 'Commission', 'commission'])) || 0;
+    let fee = parseNumeric(pickMetaTraderField(openRow, ['FEE', 'Fee', 'fee', 'Fees', 'FEES'])) || 0;
+    let swap = parseNumeric(pickMetaTraderField(openRow, ['SWAP', 'Swap', 'swap'])) || 0;
+    let pnl = parseNumeric(pickMetaTraderField(openRow, ['PROFIT', 'Profit', 'profit', 'PnL', 'P&L'])) || 0;
+
+    let exitPrice = null;
+    let exitTimeRaw = null;
+    if (closeRow) {
+      exitPrice = parseNumeric(pickMetaTraderField(closeRow, ['PRICE', 'Price', 'price', 'Close Price', 'ClosePrice']));
+      exitTimeRaw = pickMetaTraderField(closeRow, ['DATE', 'Date', 'date', 'Time', 'TIME', 'time', 'Close Time']);
+      commission += parseNumeric(pickMetaTraderField(closeRow, ['COMMISSION', 'Commission', 'commission'])) || 0;
+      fee += parseNumeric(pickMetaTraderField(closeRow, ['FEE', 'Fee', 'fee', 'Fees', 'FEES'])) || 0;
+      swap += parseNumeric(pickMetaTraderField(closeRow, ['SWAP', 'Swap', 'swap'])) || 0;
+      // Profit on the close row is the canonical realized PnL — prefer it.
+      const closePnl = parseNumeric(pickMetaTraderField(closeRow, ['PROFIT', 'Profit', 'profit', 'PnL', 'P&L']));
+      if (closePnl !== 0 || !pnl) {
+        pnl = closePnl;
+      }
+    }
+
+    if (!symbol || !openPrice || !quantity) {
+      if (diagnostics) {
+        diagnostics.invalidRows++;
+        skipReasons.push({
+          row: openEntry.rowIndex,
+          reason: `Ticket ${ticketKey}: missing symbol, price, or volume — skipped.`
+        });
+      }
+      continue;
+    }
+
+    const entryTime = parseDateTime(openTimeRaw) || parseDate(openTimeRaw);
+    const exitTime = exitTimeRaw ? (parseDateTime(exitTimeRaw) || parseDate(exitTimeRaw)) : null;
+    const tradeDate = parseDate(openTimeRaw) || entryTime;
+
+    const noteParts = [];
+    if (comment) noteParts.push(comment);
+    if (magic && magic !== '0') noteParts.push(`Magic: ${magic}`);
+    noteParts.push(`Ticket: ${ticketKey}`);
+    if (swap && Math.abs(swap) > 0.0001) noteParts.push(`Swap: ${swap}`);
+
+    completedTrades.push({
+      symbol: symbol.toUpperCase(),
+      tradeDate,
+      entryTime,
+      exitTime,
+      entryPrice: openPrice,
+      exitPrice: exitPrice || null,
+      quantity,
+      side,
+      commission,
+      // Roll swap into fees so realized PnL math stays consistent — TradeTally
+      // treats fees as a reduction of net PnL.
+      fees: fee + swap,
+      pnl: pnl,
+      stopLoss,
+      takeProfit,
+      currency: 'USD',
+      broker: 'metatrader',
+      notes: noteParts.join(' • ')
+    });
+
+    if (diagnostics) {
+      diagnostics.parsedRows++;
+    }
+  }
+
+  return completedTrades;
+}
