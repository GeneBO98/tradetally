@@ -443,6 +443,57 @@ function detectCurrencyColumn(records) {
   return false;
 }
 
+function getNonUsdCurrencies(records) {
+  if (!records || records.length === 0) {
+    return [];
+  }
+
+  const currencyFieldPatterns = new Set([
+    'currency',
+    'curr',
+    'ccy',
+    'currency_code',
+    'currencycode',
+    'price currency',
+    'currency (price / share)',
+    'currency (result)',
+    'currency (total)',
+    'ibcommissioncurrency',
+    'ib commission currency',
+    'currencyprimary',
+    'currency primary'
+  ]);
+  const validCurrencyCodePattern = /^[A-Z]{3}$/;
+  const currencies = new Set();
+
+  for (const record of records) {
+    for (const fieldName of Object.keys(record)) {
+      const lowerFieldName = fieldName.toLowerCase().trim();
+
+      if (!currencyFieldPatterns.has(lowerFieldName)) {
+        continue;
+      }
+
+      const value = record[fieldName];
+      if (!value || value.toString().trim() === '') {
+        continue;
+      }
+
+      const currencyValue = value.toString().toUpperCase().trim();
+      if (validCurrencyCodePattern.test(currencyValue) && currencyValue !== 'USD') {
+        currencies.add(currencyValue);
+      }
+    }
+  }
+
+  return Array.from(currencies).sort();
+}
+
+function buildCurrencySettingsWarning(currencies) {
+  const currencyList = currencies.length > 0 ? currencies.join(', ') : 'non-USD';
+  return `Imported broker data contains ${currencyList} currency values. Review Settings > Display Currency so reports use your preferred currency.`;
+}
+
